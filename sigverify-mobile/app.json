{
  "expo": {
    "name": "SigVerify",
    "slug": "sigverify-mobile",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0c29"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SigVerify to access your photos for signature upload.",
          "cameraPermission": "Allow SigVerify to use the camera to capture signatures."
        }
      ]
    ]
  }
}
